    {
      "finding_id": "PROV-001",
      "severity": "MEDIUM",
      "category": "LOADER_AUTHORITY",
      "finding": "There is no single canonical processed HAI loader used by every frozen path. BR2 and D0 use separate task-specific readers, each with its own strict hash/schema/access guards.",
      "scientific_impact": "No verified identity or leakage failure was found, but future maintenance could allow reader assumptions to drift unless their equivalence is reviewed and documented.",
      "evidence": [
        "src/paperworks/feasibility/hai_continuous_step_v1.py:1416-1513",
        "src/paperworks/v6/task039e3_r2r_d0_detector_training_v1.py:727-778"
      ],
      "recommended_future_action": "In a later architecture task, compare all task-specific HAI readers against one explicit input-contract matrix; do not refactor frozen implementations in this audit."
    },
    {
      "finding_id": "PROV-002",
      "severity": "MEDIUM",
      "category": "SPLIT_ENFORCEMENT_LAYER",
      "finding": "The generic assert_operation_permitted_v2 contract exists, but frozen task paths primarily enforce split/file roles through task-specific hash constants and access ledgers rather than one shared runtime permission call.",
      "scientific_impact": "The audited paths are fail-closed, but policy consistency is distributed and must be checked path by path.",
      "evidence": [
        "src/paperworks/data/splits_v2.py:85-112",
        "src/paperworks/feasibility/hai_continuous_step_v1.py:1240-1294",
        "src/paperworks/v6/candidate_discovery_protocol_v1.py:952-1026"
      ],
      "recommended_future_action": "Keep the split-governance audit explicit about generic contracts versus task-specific enforcement."

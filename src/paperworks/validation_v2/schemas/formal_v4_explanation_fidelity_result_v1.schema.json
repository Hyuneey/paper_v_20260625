{
  "$defs": {
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "numeric_binding": {
      "additionalProperties": false,
      "properties": {
        "numeric_role": {
          "type": "string"
        },
        "reference_hash": {
          "$ref": "#/$defs/sha256"
        },
        "reference_id": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "numeric_role",
        "reference_hash",
        "reference_id"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "paperworks://validation-v2/formal-v4-explanation-fidelity-result-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "all_checks_passed": {
      "type": "boolean"
    },
    "artifact_type": {
      "const": "validation_v2_formal_v4_explanation_fidelity_result_v1"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "$ref": "#/$defs/text"
          },
          "expected_hash": {
            "$ref": "#/$defs/sha256"
          },
          "observed_hash": {
            "$ref": "#/$defs/sha256"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "check_id",
          "expected_hash",
          "observed_hash",
          "passed"
        ],
        "type": "object"
      },
      "maxItems": 11,
      "minItems": 11,
      "type": "array"
    },
    "explanation_artifact_hash": {
      "$ref": "#/$defs/sha256"
    },
    "materialized_trace_hash": {
      "$ref": "#/$defs/sha256"
    },
    "result_hash": {
      "$ref": "#/$defs/sha256"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "validator_version": {
      "$ref": "#/$defs/text"
    }
  },
  "required": [
    "all_checks_passed",
    "artifact_type",
    "checks",
    "explanation_artifact_hash",
    "materialized_trace_hash",
    "result_hash",
    "schema_version",
    "validator_version"
  ],
  "title": "VALIDATION V2 Formal V4 Explanation Fidelity Result V1",
  "type": "object"
}

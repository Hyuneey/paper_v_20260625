{
  "$defs": {
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "numeric_binding": {
      "additionalProperties": false,
      "properties": {
        "numeric_role": {
          "type": "string"
        },
        "reference_hash": {
          "$ref": "#/$defs/sha256"
        },
        "reference_id": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "numeric_role",
        "reference_hash",
        "reference_id"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "paperworks://validation-v2/formal-v4-materialized-trace-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alarm_emitted": {
      "type": "boolean"
    },
    "artifact_type": {
      "const": "validation_v2_materialized_formal_v4_trace_v1"
    },
    "authorization_hash": {
      "$ref": "#/$defs/sha256"
    },
    "authorization_id": {
      "$ref": "#/$defs/text"
    },
    "causal_claim_allowed": {
      "type": "boolean"
    },
    "config_id": {
      "$ref": "#/$defs/text"
    },
    "descriptor_hash": {
      "$ref": "#/$defs/sha256"
    },
    "descriptor_set_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evaluator_contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "event_index": {
      "type": "integer"
    },
    "execution_context_hash": {
      "$ref": "#/$defs/sha256"
    },
    "experiment_id": {
      "$ref": "#/$defs/text"
    },
    "feature_contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "file_contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "final_outcome": {
      "$ref": "#/$defs/text"
    },
    "labels_accessed": {
      "type": "boolean"
    },
    "materialized_trace_version": {
      "$ref": "#/$defs/text"
    },
    "method_id": {
      "$ref": "#/$defs/text"
    },
    "numeric_authority_hash": {
      "$ref": "#/$defs/sha256"
    },
    "observation_window_hash": {
      "$ref": "#/$defs/sha256"
    },
    "opportunity_id": {
      "$ref": "#/$defs/text"
    },
    "ordered_numeric_reference_bindings": {
      "items": {
        "$ref": "#/$defs/numeric_binding"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "portfolio_authority_hash": {
      "$ref": "#/$defs/sha256"
    },
    "portfolio_id": {
      "$ref": "#/$defs/text"
    },
    "raw_numeric_values_embedded": {
      "type": "boolean"
    },
    "raw_observations_embedded": {
      "type": "boolean"
    },
    "reason": {
      "$ref": "#/$defs/text"
    },
    "relation_binding_hash": {
      "$ref": "#/$defs/sha256"
    },
    "relation_id": {
      "$ref": "#/$defs/text"
    },
    "runtime_trace_hash": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_version": {
      "$ref": "#/$defs/text"
    },
    "sampling_contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "scientific_runner_authorized": {
      "type": "boolean"
    },
    "selected_horizon_seconds": {
      "type": "integer"
    },
    "self_hash": {
      "$ref": "#/$defs/sha256"
    },
    "semantic_execution_hash": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "$ref": "#/$defs/text"
    },
    "source_commit": {
      "$ref": "#/$defs/git_commit"
    },
    "source_direction": {
      "$ref": "#/$defs/text"
    },
    "target": {
      "$ref": "#/$defs/text"
    },
    "target_direction": {
      "$ref": "#/$defs/text"
    },
    "target_response_start_index": {
      "type": "integer"
    },
    "trace_contract_hash": {
      "$ref": "#/$defs/sha256"
    },
    "trace_id": {
      "$ref": "#/$defs/text"
    }
  },
  "required": [
    "alarm_emitted",
    "artifact_type",
    "authorization_hash",
    "authorization_id",
    "causal_claim_allowed",
    "config_id",
    "descriptor_hash",
    "descriptor_set_hash",
    "evaluator_contract_hash",
    "event_index",
    "execution_context_hash",
    "experiment_id",
    "feature_contract_hash",
    "file_contract_hash",
    "final_outcome",
    "labels_accessed",
    "materialized_trace_version",
    "method_id",
    "numeric_authority_hash",
    "observation_window_hash",
    "opportunity_id",
    "ordered_numeric_reference_bindings",
    "portfolio_authority_hash",
    "portfolio_id",
    "raw_numeric_values_embedded",
    "raw_observations_embedded",
    "reason",
    "relation_binding_hash",
    "relation_id",
    "runtime_trace_hash",
    "runtime_version",
    "sampling_contract_hash",
    "schema_version",
    "scientific_runner_authorized",
    "selected_horizon_seconds",
    "semantic_execution_hash",
    "self_hash",
    "source",
    "source_commit",
    "source_direction",
    "target",
    "target_direction",
    "target_response_start_index",
    "trace_contract_hash",
    "trace_id"
  ],
  "title": "VALIDATION V2 Formal V4 Materialized Trace V1",
  "type": "object"
}

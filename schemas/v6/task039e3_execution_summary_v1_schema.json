{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperworks.local/schemas/v6/task039e3_execution_summary_v1_schema.json",
  "title": "TASK-039E3 Execution Summary V1", "type": "object", "additionalProperties": false,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/hai_source_exclusion_record_v1_schema.json",
  "title": "HAI Source Exclusion Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "variable_name", "process_id", "documented_semantic_role", "observed_domain", "task039b_source_eligibility", "primary_exclusion_reason", "secondary_exclusion_reasons", "manual_reference", "official_graph_references", "aggregate_domain_diagnostic_ref", "review_status", "metadata_confidence", "raw_values_included", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "hai_source_exclusion_record_v1"},
    "variable_name": {"type": "string", "pattern": "^P[13]_"},
    "process_id": {"enum": ["P1", "P3"]},
    "documented_semantic_role": {"type": "string", "minLength": 1},
    "observed_domain": {"type": "string", "minLength": 1},
    "task039b_source_eligibility": {"type": "boolean"},
    "primary_exclusion_reason": {"enum": ["eligible_under_failed_discrete_policy", "documented_continuous_control_command", "documented_continuous_actuator_feedback", "documented_setpoint", "documented_process_sensor", "documented_status_or_alarm", "documented_internal_or_derived", "discrete_but_not_control_semantics", "control_semantics_but_constant", "control_semantics_but_insufficient_changes", "semantic_role_unresolved", "value_domain_unresolved", "manual_and_data_evidence_conflict", "excluded_other"]},
    "secondary_exclusion_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "manual_reference": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "official_graph_references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "aggregate_domain_diagnostic_ref": {"$ref": "#/$defs/sha256"},
    "review_status": {"type": "string", "minLength": 1},
    "metadata_confidence": {"type": "string", "minLength": 1},
    "raw_values_included": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

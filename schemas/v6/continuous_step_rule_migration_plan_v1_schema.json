{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_step_rule_migration_plan_v1_schema.json",
  "title": "Continuous Step Rule Migration Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_status",
    "additive_version_required",
    "trigger_fields",
    "expected_effect_fields",
    "preserved_contracts",
    "rule_v1_modified",
    "rule_v2_created",
    "route_continuous_rules_through_rule_v1",
    "independent_schema_and_parser_required",
    "task032_hash_preservation_required",
    "creation_metadata",
    "schema_version",
    "artifact_type",
    "artifact_hash"
  ],
  "properties": {
    "plan_status": {
      "type": "string"
    },
    "additive_version_required": {
      "type": "boolean"
    },
    "trigger_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_effect_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preserved_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_v1_modified": {
      "type": "boolean"
    },
    "rule_v2_created": {
      "type": "boolean"
    },
    "route_continuous_rules_through_rule_v1": {
      "type": "boolean"
    },
    "independent_schema_and_parser_required": {
      "type": "boolean"
    },
    "task032_hash_preservation_required": {
      "type": "boolean"
    },
    "creation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "code_commit",
        "config_hash"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "continuous_step_rule_migration_plan_v1"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

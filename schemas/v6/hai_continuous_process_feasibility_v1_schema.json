{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/hai_continuous_process_feasibility_v1_schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "process_id", "process_name", "documented_sources_with_valid_fit_thresholds", "eligible_continuous_targets", "calibration_confirmed_directional_pairs", "distinct_confirmed_sources", "distinct_confirmed_targets", "fit_supported_directional_pairs", "fit_to_calibration_transfer_rate", "normal_candidate_fit_files", "normal_relation_calibration_file", "normal_guard_feature_values_accessed", "prohibited_data_access_count", "median_calibration_isolated_event_support", "manual_metadata_coverage", "metadata_unresolved_ratio", "non_isolated_source_event_ratio", "missing_or_nonfinite_rate", "source_status_counts", "fit_status_counts", "calibration_status_counts", "private_source_parameter_ledger_hash", "private_event_ledger_hash", "private_relation_ledger_hash", "feasibility_gate_passed", "process_outcome", "weighted_score_used", "official_graph_used_for_scoring", "attack_information_used", "raw_values_included", "creation_metadata", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "hai_continuous_process_feasibility_v1"}, "process_id": {"enum": ["P1", "P3"]}, "process_name": {"type": "string"},
    "documented_sources_with_valid_fit_thresholds": {"type": "integer", "minimum": 0}, "eligible_continuous_targets": {"type": "integer", "minimum": 0}, "calibration_confirmed_directional_pairs": {"type": "integer", "minimum": 0}, "distinct_confirmed_sources": {"type": "integer", "minimum": 0}, "distinct_confirmed_targets": {"type": "integer", "minimum": 0}, "fit_supported_directional_pairs": {"type": "integer", "minimum": 0},
    "fit_to_calibration_transfer_rate": {"type": "number", "minimum": 0, "maximum": 1}, "normal_candidate_fit_files": {"type": "array", "prefixItems": [{"const": "hai-train1.csv"}, {"const": "hai-train2.csv"}], "items": false}, "normal_relation_calibration_file": {"const": "hai-train3.csv"}, "normal_guard_feature_values_accessed": {"const": false}, "prohibited_data_access_count": {"const": 0},
    "median_calibration_isolated_event_support": {"type": "number", "minimum": 0}, "manual_metadata_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "metadata_unresolved_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "non_isolated_source_event_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "missing_or_nonfinite_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "source_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "fit_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "calibration_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "private_source_parameter_ledger_hash": {"$ref": "#/$defs/hash"}, "private_event_ledger_hash": {"$ref": "#/$defs/hash"}, "private_relation_ledger_hash": {"$ref": "#/$defs/hash"}, "feasibility_gate_passed": {"type": "boolean"}, "process_outcome": {"enum": ["feasible", "infeasible"]}, "weighted_score_used": {"const": false}, "official_graph_used_for_scoring": {"const": false}, "attack_information_used": {"const": false}, "raw_values_included": {"const": false}, "creation_metadata": {"$ref": "#/$defs/creation"}, "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "creation": {"type": "object", "additionalProperties": false, "required": ["created_at", "created_by", "code_commit", "config_hash"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string"}, "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "config_hash": {"$ref": "#/$defs/hash"}}}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/hai_delayed_response_screening_v1_schema.json",
  "title": "HAI Delayed Response Screening V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "screening_id", "process_id", "source_variable", "target_variable", "destination_state_hash", "selected_horizon_seconds", "selected_direction", "total_trigger_count", "isolated_trigger_count", "isolation_ratio", "usable_trigger_count", "right_censored_count", "median_delta", "directional_consistency", "robust_effect_ratio", "train1_isolated_count", "train2_isolated_count", "train1_directional_consistency", "train2_directional_consistency", "fit_supported", "calibration_isolated_count", "calibration_directional_consistency", "calibration_robust_effect_ratio", "calibration_confirmed", "readiness", "raw_values_included", "trigger_timestamps_included", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "hai_delayed_response_screening_v1"},
    "screening_id": {"$ref": "#/$defs/hash"},
    "process_id": {"enum": ["P1", "P3"]},
    "source_variable": {"type": "string"},
    "target_variable": {"type": "string"},
    "destination_state_hash": {"$ref": "#/$defs/hash"},
    "selected_horizon_seconds": {"enum": [1, 5, 10, 30, 60]},
    "selected_direction": {"enum": ["increase", "decrease"]},
    "total_trigger_count": {"$ref": "#/$defs/count"},
    "isolated_trigger_count": {"$ref": "#/$defs/count"},
    "isolation_ratio": {"$ref": "#/$defs/ratio"},
    "usable_trigger_count": {"$ref": "#/$defs/count"},
    "right_censored_count": {"$ref": "#/$defs/count"},
    "median_delta": {"type": "number"},
    "directional_consistency": {"$ref": "#/$defs/ratio"},
    "robust_effect_ratio": {"type": "number", "minimum": 0},
    "train1_isolated_count": {"$ref": "#/$defs/count"},
    "train2_isolated_count": {"$ref": "#/$defs/count"},
    "train1_directional_consistency": {"$ref": "#/$defs/ratio"},
    "train2_directional_consistency": {"$ref": "#/$defs/ratio"},
    "fit_supported": {"type": "boolean"},
    "calibration_isolated_count": {"$ref": "#/$defs/count"},
    "calibration_directional_consistency": {"$ref": "#/$defs/ratio"},
    "calibration_robust_effect_ratio": {"type": "number", "minimum": 0},
    "calibration_confirmed": {"type": "boolean"},
    "readiness": {"enum": ["canonical_increase_ready", "future_decrease_family_candidate", "unsupported_or_unstable"]},
    "raw_values_included": {"const": false},
    "trigger_timestamps_included": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

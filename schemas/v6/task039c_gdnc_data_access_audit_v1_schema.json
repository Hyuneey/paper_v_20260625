    "partial_gdnr_state_reused": {"const": false},
    "run_restarted_from_clean_commit": {"const": true},
    "raw_values_persisted": {"const": false},
    "raw_windows_persisted": {"const": false},
    "node_embeddings_persisted": {"const": false},
    "checkpoint_persisted": {"const": false},
    "private_seed_ledgers_outside_git": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},

    "candidate_feature_order_hash": {"const": "a612bdb9850ad0dd865dc62b23199bf2b696452c492e4aabe09fe554fa246d57"},
    "feature_count": {"type": "integer", "minimum": 0},
    "authorized_files": {"const": ["hai-23.05/hai-train1.csv", "hai-23.05/hai-train2.csv"]},
    "files_accessed": {"type": "array", "items": {"enum": ["hai-23.05/hai-train1.csv", "hai-23.05/hai-train2.csv"]}, "uniqueItems": true},

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039c_gdnr_execution_receipt_v1_schema.json",
  "title": "TASK039CGDNRExecutionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "task_id", "status", "blocked_gdn_base_commit",
    "phase_a_commit", "remediation_execution_commit", "protocol_bundle_hash",
    "gdn_policy_hash", "pair_universe_hash", "source_identity_hash", "target_identity_hash",
    "fidelity_receipt_hash", "environment_receipt_hash",
    "dependency_environment_fingerprint", "wheelhouse_receipt_hash",
    "scientific_source_hashes", "execution_commit_clean_at_start",
    "scientific_source_change_after_execution_start", "seeds_attempted", "seeds_completed",
    "private_seed_ledger_hashes", "evaluated_candidate_count", "supported_candidate_count",
    "ranking_hash", "data_access_audit_hash", "result_artifact_hash",
    "attention_used_for_primary_ranking", "posthoc_xai_used", "br2_pair_supervision_used",
    "meta_output_used", "stat_output_used", "checkpoint_persisted", "created_at",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "task039c_gdnr_execution_receipt_v1"},
    "task_id": {"const": "TASK-039C-GDNR"},
    "status": {"enum": ["passed_task039c_gdn_candidate_discovery", "blocked_exact_gdn_environment_unavailable", "blocked_exact_gdn_environment_missing_unapproved_extension", "failed_gdn_training", "failed_gdn_data_boundary", "failed_gdn_remediation_requires_scientific_change", "failed_gdn_result_contract", "failed_gdn_regression"]},
    "blocked_gdn_base_commit": {"const": "c0efdb6218385ec326be1a929371242314e63cb6"},
    "phase_a_commit": {"const": "229cb29cfec567e6491515de34c495a863c6e5fa"},
    "remediation_execution_commit": {"$ref": "#/$defs/gitSha"},
    "protocol_bundle_hash": {"const": "41aab751d6bbbaadc72a95ef3289ea6440c26659fb38f640bf17fb0688836dff"},
    "gdn_policy_hash": {"const": "9c2387a98312ef6c96ddcd17a871ceb70a96b670eb4a39a7269878101f2ba41a"},
    "pair_universe_hash": {"const": "fc072d3e18ce4623972c2cb64f6266727092ecae03fdb0f0dd929d705e1d8557"},
    "source_identity_hash": {"const": "0af3f80f18a3eab59b9783af64d306c8d774eeb69b3a72c24c10048abd4ed234"},
    "target_identity_hash": {"const": "063037980aae4f0eaf45fbebb59f2aa0a924fbad583f3818107a793dfe7248e7"},
    "fidelity_receipt_hash": {"const": "93821469e465a942ff94c779c6798355383e35003b13db24c19b9760ca3266c4"},
    "environment_receipt_hash": {"$ref": "#/$defs/sha256"},
    "dependency_environment_fingerprint": {"$ref": "#/$defs/sha256"},
    "wheelhouse_receipt_hash": {"$ref": "#/$defs/sha256"},
    "scientific_source_hashes": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "execution_commit_clean_at_start": {"const": true},
    "scientific_source_change_after_execution_start": {"const": false},
    "seeds_attempted": {"type": "array", "items": {"enum": [11, 23, 37]}, "uniqueItems": true},
    "seeds_completed": {"type": "array", "items": {"enum": [11, 23, 37]}, "uniqueItems": true},
    "private_seed_ledger_hashes": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["seed", "ledger_hash"], "properties": {"seed": {"enum": [11, 23, 37]}, "ledger_hash": {"$ref": "#/$defs/sha256"}}}},
    "evaluated_candidate_count": {"type": "integer", "minimum": 0, "maximum": 144},
    "supported_candidate_count": {"type": "integer", "minimum": 0, "maximum": 144},
    "ranking_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "data_access_audit_hash": {"$ref": "#/$defs/sha256"},
    "result_artifact_hash": {"$ref": "#/$defs/sha256"},
    "attention_used_for_primary_ranking": {"const": false},
    "posthoc_xai_used": {"const": false},
    "br2_pair_supervision_used": {"const": false},
    "meta_output_used": {"const": false},
    "stat_output_used": {"const": false},
    "checkpoint_persisted": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}

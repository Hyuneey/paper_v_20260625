{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039c_gdnc_execution_receipt_v1_schema.json",
  "title": "TASK039CGDNCExecutionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "task_id", "status", "gdnc_execution_commit",
    "gdnr_result_commit", "gdnr_execution_receipt_hash", "compatibility_receipt_hash",
    "environment_receipt_hash", "wheelhouse_receipt_hash", "fidelity_receipt_hash",
    "protocol_bundle_hash", "gdn_policy_hash", "pair_universe_hash",
    "source_identity_hash", "target_identity_hash", "upstream_commit",
    "scientific_source_hashes", "execution_commit_clean_at_start",
    "scientific_source_change_after_execution_start", "single_compatibility_correction_count",
    "seed_order", "seeds_attempted", "seeds_completed", "seed_retry_count",
    "private_seed_ledger_hashes", "evaluated_candidate_count", "supported_candidate_count",
    "ranking_produced", "ranking_hash", "top10_count", "top20_count", "top40_count",
    "candidate_shortfall", "data_access_audit_hash", "gdn_result_artifact_hash",
    "br2_pair_supervision_used", "meta_output_used", "stat_output_used",
    "attention_used_for_primary_ranking", "posthoc_xai_used", "checkpoint_persisted",
    "recommendation", "failure_stage", "failure_type", "created_at", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "task039c_gdnc_execution_receipt_v1"},
    "task_id": {"const": "TASK-039C-GDNC"},
    "status": {"enum": ["passed_task039c_gdn_candidate_discovery", "failed_gdn_final_attempt", "blocked_gdnc_environment_identity_mismatch"]},
    "gdnc_execution_commit": {"$ref": "#/$defs/gitSha"},
    "gdnr_result_commit": {"const": "6474816068aae786a490c634c28d665772bc2243"},
    "gdnr_execution_receipt_hash": {"const": "f46eb437aa307be41cad593fca8384d226c632738c1336a62c57554e42cf3a80"},
    "compatibility_receipt_hash": {"$ref": "#/$defs/sha256"},
    "environment_receipt_hash": {"const": "d0602e4f591073d58881aa1f918b788176ed888d5265f5e253fd272e060109c6"},
    "wheelhouse_receipt_hash": {"const": "b8e3d5fc7b66e61282d48a6a9aa28872e387534e40ead4cda691433a3bdd8cea"},
    "fidelity_receipt_hash": {"const": "93821469e465a942ff94c779c6798355383e35003b13db24c19b9760ca3266c4"},
    "protocol_bundle_hash": {"const": "41aab751d6bbbaadc72a95ef3289ea6440c26659fb38f640bf17fb0688836dff"},
    "gdn_policy_hash": {"const": "9c2387a98312ef6c96ddcd17a871ceb70a96b670eb4a39a7269878101f2ba41a"},
    "pair_universe_hash": {"const": "fc072d3e18ce4623972c2cb64f6266727092ecae03fdb0f0dd929d705e1d8557"},
    "source_identity_hash": {"const": "0af3f80f18a3eab59b9783af64d306c8d774eeb69b3a72c24c10048abd4ed234"},
    "target_identity_hash": {"const": "063037980aae4f0eaf45fbebb59f2aa0a924fbad583f3818107a793dfe7248e7"},
    "upstream_commit": {"const": "9853899da860682669a134e4af315d036aab4eca"},
    "scientific_source_hashes": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "execution_commit_clean_at_start": {"const": true},
    "scientific_source_change_after_execution_start": {"const": false},
    "single_compatibility_correction_count": {"const": 1},
    "seed_order": {"const": [11, 23, 37]},
    "seeds_attempted": {"type": "array", "items": {"enum": [11, 23, 37]}, "uniqueItems": true},
    "seeds_completed": {"type": "array", "items": {"enum": [11, 23, 37]}, "uniqueItems": true},
    "seed_retry_count": {"const": 0},
    "private_seed_ledger_hashes": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/seedLedgerHash"}},
    "evaluated_candidate_count": {"type": "integer", "minimum": 0, "maximum": 144},
    "supported_candidate_count": {"type": "integer", "minimum": 0, "maximum": 144},
    "ranking_produced": {"type": "boolean"},
    "ranking_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "top10_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "top20_count": {"type": "integer", "minimum": 0, "maximum": 20},
    "top40_count": {"type": "integer", "minimum": 0, "maximum": 40},
    "candidate_shortfall": {"oneOf": [{"$ref": "#/$defs/shortfall"}, {"type": "null"}]},
    "data_access_audit_hash": {"$ref": "#/$defs/sha256"},
    "gdn_result_artifact_hash": {"$ref": "#/$defs/sha256"},
    "br2_pair_supervision_used": {"const": false},
    "meta_output_used": {"const": false},
    "stat_output_used": {"const": false},
    "attention_used_for_primary_ranking": {"const": false},
    "posthoc_xai_used": {"const": false},
    "checkpoint_persisted": {"const": false},
    "recommendation": {"enum": ["PROCEED_WITH_THREE_ARM_INTEGRATION", "PROCEED_WITH_META_STAT_INTEGRATION_GDN_UNAVAILABLE"]},
    "failure_stage": {"type": ["string", "null"]},
    "failure_type": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "seedLedgerHash": {"type": "object", "additionalProperties": false, "required": ["seed", "ledger_hash"], "properties": {"seed": {"enum": [11, 23, 37]}, "ledger_hash": {"$ref": "#/$defs/sha256"}}},
    "shortfall": {"type": "object", "additionalProperties": false, "required": ["10", "20", "40"], "properties": {"10": {"type": "integer", "minimum": 0}, "20": {"type": "integer", "minimum": 0}, "40": {"type": "integer", "minimum": 0}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039c_gdnr_data_access_audit_v1_schema.json",
  "title": "TASK039CGDNRDataAccessAuditV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "task_id", "status",
    "environment_receipt_hash", "process_id", "split_role",
    "candidate_learning_view_id", "candidate_feature_order_hash", "feature_count",
    "authorized_files", "files_accessed", "train1_accessed", "train2_accessed",
    "train3_accessed", "train4_accessed", "test_accessed", "labels_accessed",
    "attacks_accessed", "br2_pair_supervision_used", "meta_output_used",
    "stat_output_used", "p2_p3_p4_feature_values_accessed", "raw_values_persisted",
    "raw_windows_persisted", "node_embeddings_persisted", "checkpoint_persisted",
    "private_seed_ledgers_outside_git", "created_at", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "task039c_gdnr_data_access_audit_v1"},
    "task_id": {"const": "TASK-039C-GDNR"},
    "status": {"enum": ["passed_task039c_gdn_candidate_discovery", "blocked_exact_gdn_environment_unavailable", "blocked_exact_gdn_environment_missing_unapproved_extension", "failed_gdn_training", "failed_gdn_data_boundary", "failed_gdn_remediation_requires_scientific_change", "failed_gdn_result_contract", "failed_gdn_regression"]},
    "environment_receipt_hash": {"$ref": "#/$defs/sha256"},
    "process_id": {"const": "P1"},
    "split_role": {"const": "NORMAL_CANDIDATE_FIT"},
    "candidate_learning_view_id": {"const": "eaa77f331bf79cc6887ccddcfff8818880c1a93c16ebc6fdd2d06a1c8db37eca"},
    "candidate_feature_order_hash": {"const": "a612bdb9850ad0dd865dc62b23199bf2b696452c492e4aabe09fe554fa246d57"},
    "feature_count": {"type": "integer", "minimum": 0},
    "authorized_files": {"const": ["hai-23.05/hai-train1.csv", "hai-23.05/hai-train2.csv"]},
    "files_accessed": {"type": "array", "items": {"enum": ["hai-23.05/hai-train1.csv", "hai-23.05/hai-train2.csv"]}, "uniqueItems": true},
    "train1_accessed": {"type": "boolean"},
    "train2_accessed": {"type": "boolean"},
    "train3_accessed": {"const": false},
    "train4_accessed": {"const": false},
    "test_accessed": {"const": false},
    "labels_accessed": {"const": false},
    "attacks_accessed": {"const": false},
    "br2_pair_supervision_used": {"const": false},
    "meta_output_used": {"const": false},
    "stat_output_used": {"const": false},
    "p2_p3_p4_feature_values_accessed": {"const": false},
    "raw_values_persisted": {"const": false},
    "raw_windows_persisted": {"const": false},
    "node_embeddings_persisted": {"const": false},
    "checkpoint_persisted": {"const": false},
    "private_seed_ledgers_outside_git": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039e1_private_construction_evidence_v1_schema.json",
  "title": "PrivateConstructionEvidenceV1 preparation draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "relation_binding_hash",
    "relation_identity", "source", "source_step_direction", "target",
    "target_response_direction", "selected_horizon_seconds",
    "source_parameter_record_hash", "target_parameter_record_hash",
    "d1_fit_evidence_hash", "d2_confirmation_evidence_hash",
    "window_constant_bundle_hash", "numeric_bindings", "evidence_authority",
    "construction_evidence_status", "private_record", "rule_generated",
    "runtime_authority_granted", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "private_construction_evidence_v1"},
    "relation_binding_hash": {"$ref": "#/$defs/hash"},
    "relation_identity": {"$ref": "#/$defs/syntheticIdentifier"},
    "source": {"$ref": "#/$defs/syntheticIdentifier"},
    "source_step_direction": {"enum": ["step_up", "step_down"]},
    "target": {"$ref": "#/$defs/syntheticIdentifier"},
    "target_response_direction": {"enum": ["increase", "decrease"]},
    "selected_horizon_seconds": {"type": "integer", "minimum": 1},
    "source_parameter_record_hash": {"$ref": "#/$defs/hash"},
    "target_parameter_record_hash": {"$ref": "#/$defs/hash"},
    "d1_fit_evidence_hash": {"$ref": "#/$defs/hash"},
    "d2_confirmation_evidence_hash": {"$ref": "#/$defs/hash"},
    "window_constant_bundle_hash": {"$ref": "#/$defs/hash"},
    "numeric_bindings": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {"$ref": "#/$defs/numericBinding"}
    },
    "evidence_authority": {"const": "approved_construction_evidence"},
    "construction_evidence_status": {"const": "approved"},
    "private_record": {"const": true},
    "rule_generated": {"const": false},
    "runtime_authority_granted": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "syntheticIdentifier": {"type": "string", "pattern": "^SYNTHETIC_[A-Za-z0-9._:-]+$"},
    "numericRole": {
      "enum": [
        "source_step_threshold", "source_stability_tolerance",
        "target_noise_scale", "selected_delay_horizon_seconds",
        "source_pre_window_seconds", "source_post_window_seconds",
        "minimum_source_stability_fraction", "source_refractory_seconds",
        "cross_source_isolation_radius_seconds",
        "target_baseline_window_seconds", "target_response_window_seconds"
      ]
    },
    "numericBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric_role", "numeric_value", "value_origin",
        "source_parameter_record_hash", "target_parameter_record_hash",
        "d1_fit_evidence_hash", "d2_confirmation_evidence_hash",
        "window_constant_bundle_hash", "evidence_authority", "llm_generated",
        "runtime_authority_granted", "numeric_reference"
      ],
      "properties": {
        "numeric_role": {"$ref": "#/$defs/numericRole"},
        "numeric_value": {"type": "number"},
        "value_origin": {
          "enum": [
            "d1_fit_derived_source_parameter",
            "d1_fit_derived_target_parameter",
            "d1_fit_selected_horizon",
            "d0_preregistered_window_constant"
          ]
        },
        "source_parameter_record_hash": {"$ref": "#/$defs/hash"},
        "target_parameter_record_hash": {"$ref": "#/$defs/hash"},
        "d1_fit_evidence_hash": {"$ref": "#/$defs/hash"},
        "d2_confirmation_evidence_hash": {"$ref": "#/$defs/hash"},
        "window_constant_bundle_hash": {"$ref": "#/$defs/hash"},
        "evidence_authority": {"const": "approved_construction_evidence"},
        "llm_generated": {"const": false},
        "runtime_authority_granted": {"const": false},
        "numeric_reference": {"$ref": "#/$defs/hash"}
      }
    }
  }
}

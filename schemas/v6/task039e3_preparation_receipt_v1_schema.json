{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039e3_preparation_receipt_v1_schema.json",
  "title": "TASK-039E3 Preparation Receipt V1",
  "type": "object",
  "properties": {
    "artifact_type": {"const": "task039e3_preparation_receipt_v1"},
    "status": {"const": "passed_task039e3_scientific_execution_preparation"},
    "frozen_e2_configuration_bound": {"const": true},
    "mock_provider_prepared": {"const": true},
    "live_provider_locked": {"const": true},
    "capability_probe_harness_prepared": {"const": true},
    "orchestration_harness_prepared": {"const": true},
    "custody_and_metrics_prepared": {"const": true},
    "real_e1_private_evidence_accessed": {"const": false},
    "provider_contacted": {"const": false},
    "credential_accessed": {"const": false},
    "capability_probe_executed_live": {"const": false},
    "llm_called": {"const": false},
    "real_proposal_generated": {"const": false},
    "rule_v2_authorized": {"const": false},
    "runtime_authority": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "required": [
    "artifact_type",
    "status",
    "frozen_e2_configuration_bound",
    "mock_provider_prepared",
    "live_provider_locked",
    "capability_probe_harness_prepared",
    "orchestration_harness_prepared",
    "custody_and_metrics_prepared",
    "real_e1_private_evidence_accessed",
    "provider_contacted",
    "credential_accessed",
    "capability_probe_executed_live",
    "llm_called",
    "real_proposal_generated",
    "rule_v2_authorized",
    "runtime_authority",
    "artifact_hash"
  ],
  "additionalProperties": false,
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

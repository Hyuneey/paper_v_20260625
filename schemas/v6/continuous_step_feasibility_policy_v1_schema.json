{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_step_feasibility_policy_v1_schema.json",
  "title": "Continuous Step Feasibility Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_fit_files",
    "calibration_file",
    "normal_guard_values_prohibited",
    "screening_dimensions",
    "required_aggregate_statistics",
    "ranking_order",
    "fit_total_isolated_events_minimum",
    "fit_per_file_isolated_events_minimum",
    "fit_directional_consistency_minimum",
    "fit_per_file_directional_consistency_minimum",
    "fit_robust_effect_ratio_minimum",
    "fit_direction_agreement_required",
    "calibration_isolated_events_minimum",
    "calibration_directional_consistency_minimum",
    "calibration_robust_effect_ratio_minimum",
    "frozen_fit_fields_on_calibration",
    "multiple_horizons_do_not_inflate_pairs",
    "unconditioned_screening_feasibility_only",
    "final_operating_regime_binding_required",
    "weighted_score_used",
    "real_data_executed",
    "creation_metadata",
    "schema_version",
    "artifact_type",
    "artifact_hash"
  ],
  "properties": {
    "candidate_fit_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calibration_file": {
      "type": "string"
    },
    "normal_guard_values_prohibited": {
      "type": "boolean"
    },
    "screening_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_aggregate_statistics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ranking_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fit_total_isolated_events_minimum": {
      "type": "integer"
    },
    "fit_per_file_isolated_events_minimum": {
      "type": "integer"
    },
    "fit_directional_consistency_minimum": {
      "type": "number"
    },
    "fit_per_file_directional_consistency_minimum": {
      "type": "number"
    },
    "fit_robust_effect_ratio_minimum": {
      "type": "number"
    },
    "fit_direction_agreement_required": {
      "type": "boolean"
    },
    "calibration_isolated_events_minimum": {
      "type": "integer"
    },
    "calibration_directional_consistency_minimum": {
      "type": "number"
    },
    "calibration_robust_effect_ratio_minimum": {
      "type": "number"
    },
    "frozen_fit_fields_on_calibration": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "multiple_horizons_do_not_inflate_pairs": {
      "type": "boolean"
    },
    "unconditioned_screening_feasibility_only": {
      "type": "boolean"
    },
    "final_operating_regime_binding_required": {
      "type": "boolean"
    },
    "weighted_score_used": {
      "type": "boolean"
    },
    "real_data_executed": {
      "type": "boolean"
    },
    "creation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "code_commit",
        "config_hash"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "continuous_step_feasibility_policy_v1"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/normal_relation_evidence_v1_schema.json",
  "title": "NormalRelationEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "evidence_id",
    "artifact_hash",
    "dataset_manifest_id",
    "data_view_id",
    "split_manifest_id",
    "split_role",
    "process_scope",
    "source_variable",
    "target_variable",
    "source_metadata_ref",
    "target_metadata_ref",
    "candidate_universe_ref",
    "candidate_edge_refs",
    "relation_family",
    "response_direction",
    "operating_regime_id",
    "operating_regime_status",
    "operating_regime_condition_refs",
    "support_summary",
    "lag_summary",
    "response_magnitude_summary",
    "persistence_summary",
    "stability_summary",
    "evidence_status",
    "evidence_insufficiency_reasons",
    "matched_normal_reference_refs",
    "calibration_parameter_refs",
    "provenance_references",
    "creation_metadata",
    "raw_values_included",
    "label_performance_used",
    "detector_context_used",
    "prohibited_claims",
    "validity_authority_granted",
    "runtime_authority_granted",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "normal_relation_evidence"},
    "evidence_id": {"pattern": "^NRE-V1:[a-f0-9]{64}$"},
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "dataset_manifest_id": {"$ref": "#/$defs/hash"},
    "data_view_id": {"$ref": "#/$defs/hash"},
    "split_manifest_id": {"$ref": "#/$defs/hash"},
    "split_role": {"const": "normal_relation_calibration"},
    "process_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_variable": {"type": "string", "minLength": 1},
    "target_variable": {"type": "string", "minLength": 1},
    "source_metadata_ref": {"$ref": "#/$defs/hash"},
    "target_metadata_ref": {"$ref": "#/$defs/hash"},
    "candidate_universe_ref": {"$ref": "#/$defs/hash"},
    "candidate_edge_refs": {"$ref": "#/$defs/nonemptyHashArray"},
    "relation_family": {"const": "delayed_response"},
    "response_direction": {"enum": ["increase", "decrease"]},
    "operating_regime_id": {"type": "string", "minLength": 1},
    "operating_regime_status": {
      "enum": ["verified", "unverified", "unknown"]
    },
    "operating_regime_condition_refs": {"$ref": "#/$defs/hashArray"},
    "support_summary": {"$ref": "#/$defs/supportSummary"},
    "lag_summary": {
      "anyOf": [{"$ref": "#/$defs/distributionSummary"}, {"type": "null"}]
    },
    "response_magnitude_summary": {
      "anyOf": [{"$ref": "#/$defs/distributionSummary"}, {"type": "null"}]
    },
    "persistence_summary": {
      "anyOf": [{"$ref": "#/$defs/distributionSummary"}, {"type": "null"}]
    },
    "stability_summary": {"$ref": "#/$defs/stabilitySummary"},
    "evidence_status": {
      "enum": ["supported", "insufficient_support", "unstable"]
    },
    "evidence_insufficiency_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/noRuleReason"}
    },
    "matched_normal_reference_refs": {"$ref": "#/$defs/hashArray"},
    "calibration_parameter_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/parameterReference"}
    },
    "provenance_references": {"$ref": "#/$defs/nonemptyHashArray"},
    "creation_metadata": {"$ref": "#/$defs/creationMetadata"},
    "raw_values_included": {"const": false},
    "label_performance_used": {"const": false},
    "detector_context_used": {"const": false},
    "prohibited_claims": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [
        {"contains": {"const": "physical_causality"}},
        {"contains": {"const": "root_cause"}},
        {"contains": {"const": "universal_invariant"}}
      ],
      "items": {"type": "string", "minLength": 1}
    },
    "validity_authority_granted": {"const": false},
    "runtime_authority_granted": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_status": {"const": "supported"}}},
      "then": {
        "properties": {
          "evidence_insufficiency_reasons": {"maxItems": 0},
          "matched_normal_reference_refs": {"minItems": 1},
          "lag_summary": {"$ref": "#/$defs/distributionSummary"},
          "response_magnitude_summary": {"$ref": "#/$defs/distributionSummary"},
          "stability_summary": {
            "properties": {"status": {"const": "stable"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"evidence_status": {"const": "insufficient_support"}}
      },
      "then": {"properties": {"evidence_insufficiency_reasons": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"evidence_status": {"const": "unstable"}}},
      "then": {
        "properties": {
          "evidence_insufficiency_reasons": {"minItems": 1},
          "stability_summary": {
            "properties": {"status": {"const": "unstable"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hashArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "nonemptyHashArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "supportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_count",
        "evaluable_trigger_count",
        "matched_response_count",
        "missing_response_count",
        "right_censored_count"
      ],
      "properties": {
        "trigger_count": {"type": "integer", "minimum": 0},
        "evaluable_trigger_count": {"type": "integer", "minimum": 0},
        "matched_response_count": {"type": "integer", "minimum": 0},
        "missing_response_count": {"type": "integer", "minimum": 0},
        "right_censored_count": {"type": "integer", "minimum": 0}
      }
    },
    "distributionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "minimum",
        "p50",
        "p95",
        "maximum",
        "unit",
        "method",
        "value_semantics"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number"},
        "p50": {"type": "number"},
        "p95": {"type": ["number", "null"]},
        "maximum": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "value_semantics": {
          "enum": ["lag", "absolute_response_magnitude", "persistence"]
        }
      }
    },
    "stabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "replicate_count",
        "variation_measure",
        "confidence_lower",
        "confidence_upper"
      ],
      "properties": {
        "status": {"enum": ["stable", "unstable", "not_assessed"]},
        "method": {"type": "string", "minLength": 1},
        "replicate_count": {"type": "integer", "minimum": 0},
        "variation_measure": {"type": ["number", "null"]},
        "confidence_lower": {"type": ["number", "null"]},
        "confidence_upper": {"type": ["number", "null"]}
      }
    },
    "parameterReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact_ref"],
      "properties": {
        "role": {"enum": ["lag", "tolerance", "persistence"]},
        "artifact_ref": {"$ref": "#/$defs/hash"}
      }
    },
    "noRuleReason": {
      "enum": [
        "insufficient_trigger_support",
        "insufficient_matched_response_support",
        "unstable_response_direction",
        "unstable_lag",
        "unstable_magnitude",
        "missing_matched_normal_reference",
        "missing_calibration_parameter",
        "relation_not_reproducible"
      ]
    },
    "creationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "created_by", "code_commit", "config_hash"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string", "minLength": 1},
        "code_commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{7,40}|unverified)$"
        },
        "config_hash": {
          "anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        }
      }
    }
  }
}

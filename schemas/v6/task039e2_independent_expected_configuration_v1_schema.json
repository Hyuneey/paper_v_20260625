{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039e2_independent_expected_configuration_v1_schema.json",
  "title": "TASK-039E2 Independent Expected Configuration V1",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "independent_execution_configuration_v1"},
    "provider": {"const": "openai"},
    "endpoint": {"const": "/v1/chat/completions"},
    "model": {"const": "gpt-5.4-2026-03-05"},
    "reasoning": {"const": "none"},
    "temperature": {"const": 0.7},
    "top_p": {"const": 1.0},
    "max_completion_tokens": {"const": 1024},
    "seed": {"type": "null"},
    "stream": {"const": false},
    "store": {"const": false},
    "model_fallback": {"const": false},
    "prompt_hash_manifest_hash": {"$ref": "#/$defs/hash"},
    "structured_schema_manifest_hash": {"$ref": "#/$defs/hash"},
    "rendering_policy_hash": {"$ref": "#/$defs/hash"},
    "retrieval_policy_hash": {"$ref": "#/$defs/hash"},
    "t0_template_hash": {"$ref": "#/$defs/hash"},
    "schedule_hash": {"$ref": "#/$defs/hash"},
    "retry_policy_hash": {"$ref": "#/$defs/hash"},
    "direct_number_role_policy_hash": {"$ref": "#/$defs/hash"},
    "provider_contacted": {"const": false},
    "execution_started": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "required": [
    "schema_version",
    "artifact_type",
    "provider",
    "endpoint",
    "model",
    "reasoning",
    "temperature",
    "top_p",
    "max_completion_tokens",
    "seed",
    "stream",
    "store",
    "model_fallback",
    "prompt_hash_manifest_hash",
    "structured_schema_manifest_hash",
    "rendering_policy_hash",
    "retrieval_policy_hash",
    "t0_template_hash",
    "schedule_hash",
    "retry_policy_hash",
    "direct_number_role_policy_hash",
    "provider_contacted",
    "execution_started",
    "artifact_hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

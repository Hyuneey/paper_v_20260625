    "result_artifact_hashes": {"$ref": "#/$defs/armHashes"},
    "ranking_hashes": {"type": "object", "additionalProperties": false, "required": ["META", "STAT", "GDN"], "properties": {"META": {"type": "null"}, "STAT": {"$ref": "#/$defs/sha256"}, "GDN": {"$ref": "#/$defs/sha256"}}},
    "audited_preview_hash": {"$ref": "#/$defs/sha256"}, "candidate_identity_list_hash": {"$ref": "#/$defs/sha256"}, "candidate_cohort_hash": {"$ref": "#/$defs/sha256"}, "overlap_artifact_hash": {"$ref": "#/$defs/sha256"}, "task039d0_authorization_hash": {"$ref": "#/$defs/sha256"},

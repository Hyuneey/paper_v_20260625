  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "armHashes": {"type": "object", "additionalProperties": false, "required": ["META", "STAT", "GDN"], "properties": {"META": {"$ref": "#/$defs/sha256"}, "STAT": {"$ref": "#/$defs/sha256"}, "GDN": {"$ref": "#/$defs/sha256"}}}

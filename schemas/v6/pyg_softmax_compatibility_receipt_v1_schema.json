{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/pyg_softmax_compatibility_receipt_v1_schema.json",
  "title": "PyGSoftmaxCompatibilityReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "status",
    "classification",
    "upstream_repository",
    "upstream_commit",
    "upstream_dependency_versions",
    "approved_dependency_versions",
    "upstream_softmax_call",
    "frozen_port_softmax_call_before_correction",
    "installed_pyg_softmax_signature",
    "corrected_softmax_binding",
    "patched_implementation_path",
    "patched_implementation_hash",
    "patched_implementation_hash_method",
    "original_fidelity_receipt_hash",
    "failed_gdnr_execution_receipt_hash",
    "exact_environment_receipt_hash",
    "wheelhouse_receipt_hash",
    "frozen_hyperparameter_hash",
    "semantic_equivalence",
    "upstream_semantics_preserved",
    "upstream_source_unchanged",
    "model_equations_unchanged",
    "tensor_grouping_unchanged",
    "node_count_semantics_unchanged",
    "only_dependency_api_binding_changed",
    "hai_result_information_used_to_design_correction",
    "meta_stat_results_consulted",
    "br2_pair_results_consulted",
    "candidate_ranking_existed_before_correction",
    "created_at",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "pyg_softmax_compatibility_receipt_v1"},
    "task_id": {"const": "TASK-039C-GDNC"},
    "status": {"const": "passed_semantics_preserving_pyg_softmax_compatibility"},
    "classification": {"const": "documented_non_scientific_api_adapter"},
    "upstream_repository": {"const": "https://github.com/d-ailin/GDN"},
    "upstream_commit": {"const": "9853899da860682669a134e4af315d036aab4eca"},
    "upstream_dependency_versions": {"$ref": "#/$defs/upstreamVersions"},
    "approved_dependency_versions": {"$ref": "#/$defs/approvedVersions"},
    "upstream_softmax_call": {"const": "softmax(alpha, edge_index_i, size_i)"},
    "frozen_port_softmax_call_before_correction": {"const": "softmax(alpha, edge_index_i, size_i)"},
    "installed_pyg_softmax_signature": {"type": "string", "minLength": 1},
    "corrected_softmax_binding": {"const": "softmax(src, index=index, num_nodes=num_nodes)"},
    "patched_implementation_path": {"const": "src/paperworks/gdn/upstream_candidate_backend_v1.py"},
    "patched_implementation_hash": {"$ref": "#/$defs/sha256"},
    "patched_implementation_hash_method": {"const": "sha256_utf8_lf_canonical_text"},
    "original_fidelity_receipt_hash": {"const": "93821469e465a942ff94c779c6798355383e35003b13db24c19b9760ca3266c4"},
    "failed_gdnr_execution_receipt_hash": {"const": "f46eb437aa307be41cad593fca8384d226c632738c1336a62c57554e42cf3a80"},
    "exact_environment_receipt_hash": {"const": "d0602e4f591073d58881aa1f918b788176ed888d5265f5e253fd272e060109c6"},
    "wheelhouse_receipt_hash": {"const": "b8e3d5fc7b66e61282d48a6a9aa28872e387534e40ead4cda691433a3bdd8cea"},
    "frozen_hyperparameter_hash": {"const": "68fbd006af1bc71468c157ba90888f54b8c0cbeba1aa7aba1121701a5b87870e"},
    "semantic_equivalence": {"$ref": "#/$defs/semanticEquivalence"},
    "upstream_semantics_preserved": {"const": true},
    "upstream_source_unchanged": {"const": true},
    "model_equations_unchanged": {"const": true},
    "tensor_grouping_unchanged": {"const": true},
    "node_count_semantics_unchanged": {"const": true},
    "only_dependency_api_binding_changed": {"const": true},
    "hai_result_information_used_to_design_correction": {"const": false},
    "meta_stat_results_consulted": {"const": false},
    "br2_pair_results_consulted": {"const": false},
    "candidate_ranking_existed_before_correction": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "upstreamVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["torch", "torch-geometric"],
      "properties": {"torch": {"const": "1.5.1"}, "torch-geometric": {"const": "1.5.0"}}
    },
    "approvedVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["torch", "torch-geometric"],
      "properties": {"torch": {"const": "2.12.1"}, "torch-geometric": {"const": "2.8.0"}}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "dtype", "input_shape", "element_count", "num_nodes", "max_absolute_error", "max_relative_error", "passed"],
      "properties": {
        "case_id": {"enum": ["two_groups_positive_negative_repeated", "unused_nodes_and_one_element_group", "large_magnitude_stability", "multidimensional_graph_layer_shape"]},
        "dtype": {"const": "float64"},
        "input_shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "element_count": {"type": "integer", "minimum": 1},
        "num_nodes": {"type": "integer", "minimum": 1},
        "max_absolute_error": {"type": "number", "minimum": 0, "maximum": 1e-12},
        "max_relative_error": {"type": "number", "minimum": 0, "maximum": 1e-12},
        "passed": {"const": true}
      }
    },
    "semanticEquivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_method", "float64_absolute_tolerance", "float64_relative_tolerance", "float32_graph_layer_absolute_tolerance", "float32_graph_layer_relative_tolerance", "tolerance_basis", "cases"],
      "properties": {
        "reference_method": {"const": "independent_numerically_stable_grouped_softmax"},
        "float64_absolute_tolerance": {"const": 1e-12},
        "float64_relative_tolerance": {"const": 1e-12},
        "float32_graph_layer_absolute_tolerance": {"const": 1e-6},
        "float32_graph_layer_relative_tolerance": {"const": 1e-6},
        "tolerance_basis": {"const": "precommitted_dtype_rounding_only"},
        "cases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/case"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/gdn_port_compatibility_closure_receipt_v1_schema.json",
  "title": "GDN Port Compatibility Closure Receipt V1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "status",
    "prior_fidelity_receipt_hash",
    "softmax_compatibility_receipt_hash",
    "exact_environment_receipt_hash",
    "previous_gdnc_failure_receipt_hash",
    "api_drift_matrix_hash",
    "node_dim_root_cause_confirmed",
    "node_dim_adapter",
    "additional_adapters",
    "gate_statuses",
    "legacy_oracle_status",
    "unresolved_compatibility_fields",
    "patched_implementation_hash",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "gdn_port_compatibility_closure_receipt_v1"},
    "task_id": {"const": "TASK-039C-GDNP"},
    "status": {"const": "passed_pyg15_to_pyg28_gdn_port_compatibility_closure"},
    "prior_fidelity_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "softmax_compatibility_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_environment_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_gdnc_failure_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "api_drift_matrix_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_dim_root_cause_confirmed": {"const": true},
    "node_dim_adapter": {"type": "object"},
    "additional_adapters": {"type": "array", "maxItems": 0},
    "gate_statuses": {"type": "object"},
    "legacy_oracle_status": {"enum": ["passed_legacy_pyg15_synthetic_oracle", "blocked_official_legacy_environment_unavailable"]},
    "unresolved_compatibility_fields": {"type": "array", "maxItems": 0},
    "patched_implementation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}

{
  "$id": "https://paperworks.local/schemas/v6/hai_official_distribution_metadata_v1_schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_hash": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "artifact_type": {"const": "hai_official_distribution_metadata"},
    "complete_file_inventory": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "advertised_size_bytes": {"minimum": 0, "type": "integer"},
          "creation_date": {"format": "date-time", "type": "string"},
          "file_type": {"minLength": 1, "type": "string"},
          "name": {"minLength": 1, "type": "string"}
        },
        "required": ["name", "advertised_size_bytes", "creation_date", "file_type"],
        "type": "object"
      },
      "minItems": 10,
      "type": "array"
    },
    "complete_file_inventory_count": {"minimum": 10, "type": "integer"},
    "complete_inventory_frozen": {"const": true},
    "created_at": {"format": "date-time", "type": "string"},
    "credentials_included": {"const": false},
    "dataset_ref": {"const": "icsdataset/hai-security-dataset"},
    "dataset_version_identifier": {"minimum": 1, "type": "integer"},
    "execution_code_commit": {"pattern": "^[a-f0-9]{40}$", "type": "string"},
    "file_inventory_endpoint": {"pattern": "^https://www\\.kaggle\\.com/api/v1/", "type": "string"},
    "introduction_commit": {"pattern": "^[a-f0-9]{40}$", "type": "string"},
    "kaggle_api_version": {"const": "v1"},
    "kaggle_client_name": {"const": "paperworks_stdlib_urllib"},
    "kaggle_client_version": {"const": "1.0.0"},
    "license_name": {"const": "CC BY-SA 4.0"},
    "metadata_endpoint": {"pattern": "^https://www\\.kaggle\\.com/api/v1/", "type": "string"},
    "official_git_repository": {"const": "https://github.com/icsdataset/hai"},
    "official_git_snapshot_commit": {"pattern": "^[a-f0-9]{40}$", "type": "string"},
    "owner": {"const": "icsdataset"},
    "schema_version": {"const": "1.0.0"},
    "selective_download_endpoint_template": {"pattern": "^https://www\\.kaggle\\.com/api/v1/", "type": "string"},
    "signed_urls_included": {"const": false},
    "slug": {"const": "hai-security-dataset"},
    "task039a_expected_config_hash": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "task_id": {"const": "TASK-039AR"},
    "version_timestamp": {"format": "date-time", "type": "string"}
  },
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "owner",
    "slug",
    "dataset_ref",
    "dataset_version_identifier",
    "version_timestamp",
    "license_name",
    "complete_file_inventory",
    "complete_file_inventory_count",
    "official_git_repository",
    "official_git_snapshot_commit",
    "introduction_commit",
    "task039a_expected_config_hash",
    "kaggle_client_name",
    "kaggle_client_version",
    "kaggle_api_version",
    "metadata_endpoint",
    "file_inventory_endpoint",
    "selective_download_endpoint_template",
    "complete_inventory_frozen",
    "credentials_included",
    "signed_urls_included",
    "created_at",
    "execution_code_commit",
    "artifact_hash"
  ],
  "title": "HAI Official Distribution Metadata V1",
  "type": "object"
}

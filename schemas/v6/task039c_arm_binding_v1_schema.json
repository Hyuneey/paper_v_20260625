{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039c_arm_binding_v1_schema.json",
  "title": "TASK039CArmBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "arm_id", "claim_boundary", "implementation_commit", "result_commit", "result_artifact_hash", "ranking_hash", "policy_hash", "evidence_binding_hashes", "data_access_audit_hash", "evaluated_count", "supported_count", "top20_count", "br2_pair_supervision_used", "cross_arm_score_used", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "task039c_arm_binding_v1"},
    "arm_id": {"enum": ["META", "STAT", "GDN"]},
    "claim_boundary": {"enum": ["metadata candidate evidence", "lagged change-correlation candidate evidence", "learned-graph candidate evidence"]},
    "implementation_commit": {"$ref": "#/$defs/gitSha"},
    "result_commit": {"$ref": "#/$defs/gitSha"},
    "result_artifact_hash": {"$ref": "#/$defs/sha256"},
    "ranking_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "policy_hash": {"$ref": "#/$defs/sha256"},
    "evidence_binding_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "data_access_audit_hash": {"$ref": "#/$defs/sha256"},
    "evaluated_count": {"const": 144},
    "supported_count": {"type": "integer", "minimum": 20, "maximum": 144},
    "top20_count": {"const": 20},
    "br2_pair_supervision_used": {"const": false},
    "cross_arm_score_used": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039e2_construction_execution_schedule_v1_schema.json",
  "title": "ConstructionExecutionScheduleV1 synthetic preparation draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "relation_identities", "relation_count",
    "configuration_hash", "scientific_generation_budget_hash",
    "deterministic_arm_order", "relation_ordering_policy", "result_dependent_ordering",
    "t1_calls_per_relation", "t1b_calls_per_relation", "t2_maximum_calls_per_relation",
    "direct_number_calls_per_relation", "expected_maximum_scientific_calls",
    "hidden_extra_calls_allowed", "same_provider_model_configuration_all_llm_arms",
    "schedule_frozen_before_any_proposal", "synthetic_preparation_schedule",
    "actual_execution_schedule", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "construction_execution_schedule_v1"},
    "relation_identities": {"type": "array", "minItems": 42, "maxItems": 42, "uniqueItems": true, "items": {"$ref": "#/$defs/syntheticIdentifier"}},
    "relation_count": {"const": 42},
    "configuration_hash": {"$ref": "#/$defs/hash"},
    "scientific_generation_budget_hash": {"$ref": "#/$defs/hash"},
    "deterministic_arm_order": {"const": ["T0", "T1", "T1-B", "T2", "T1-DIRECT-NUMBER"]},
    "relation_ordering_policy": {"const": "frozen_e0_cohort_order"},
    "result_dependent_ordering": {"const": false},
    "t1_calls_per_relation": {"const": 1},
    "t1b_calls_per_relation": {"const": 3},
    "t2_maximum_calls_per_relation": {"const": 3},
    "direct_number_calls_per_relation": {"const": 1},
    "expected_maximum_scientific_calls": {"const": 336},
    "hidden_extra_calls_allowed": {"const": false},
    "same_provider_model_configuration_all_llm_arms": {"const": true},
    "schedule_frozen_before_any_proposal": {"const": true},
    "synthetic_preparation_schedule": {"const": true},
    "actual_execution_schedule": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "syntheticIdentifier": {"type": "string", "pattern": "^SYNTHETIC_[A-Za-z0-9._:-]+$"}
  }
}

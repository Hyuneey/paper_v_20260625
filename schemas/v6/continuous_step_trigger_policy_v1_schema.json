{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_step_trigger_policy_v1_schema.json",
  "title": "Continuous Step Trigger Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sampling_interval_seconds",
    "pre_window_seconds",
    "post_hold_window_seconds",
    "minimum_stability_fraction",
    "source_refractory_seconds",
    "cross_source_isolation_radius_seconds",
    "numeric_epsilon",
    "source_roles",
    "observed_domain",
    "manual_review_required",
    "metadata_confidence_policy",
    "finite_nonconstant_repeated_changes_all_fit_and_calibration_required",
    "setpoints_excluded",
    "discrete_sources_routed_to_family",
    "data_behavior_grants_control_semantics",
    "official_graph_grants_source_eligibility",
    "cross_file_or_split_events_allowed",
    "candidate_fit_files",
    "source_noise_scale_formula",
    "pre_level_formula",
    "post_level_formula",
    "step_amplitude_formula",
    "minimum_nontrivial_amplitudes",
    "q75_method",
    "source_step_threshold_formula",
    "source_stability_tolerance_formula",
    "cluster_retention_policy",
    "exact_amplitude_tie_policy",
    "directions_retained_separately",
    "calibration_or_target_feedback_used",
    "final_rule_parameter_authority",
    "creation_metadata",
    "schema_version",
    "artifact_type",
    "artifact_hash"
  ],
  "properties": {
    "sampling_interval_seconds": {
      "type": "number"
    },
    "pre_window_seconds": {
      "type": "integer"
    },
    "post_hold_window_seconds": {
      "type": "integer"
    },
    "minimum_stability_fraction": {
      "type": "number"
    },
    "source_refractory_seconds": {
      "type": "integer"
    },
    "cross_source_isolation_radius_seconds": {
      "type": "integer"
    },
    "numeric_epsilon": {
      "type": "number"
    },
    "source_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_domain": {
      "type": "string"
    },
    "manual_review_required": {
      "type": "boolean"
    },
    "metadata_confidence_policy": {
      "type": "string"
    },
    "finite_nonconstant_repeated_changes_all_fit_and_calibration_required": {
      "type": "boolean"
    },
    "setpoints_excluded": {
      "type": "boolean"
    },
    "discrete_sources_routed_to_family": {
      "type": "boolean"
    },
    "data_behavior_grants_control_semantics": {
      "type": "boolean"
    },
    "official_graph_grants_source_eligibility": {
      "type": "boolean"
    },
    "cross_file_or_split_events_allowed": {
      "type": "boolean"
    },
    "candidate_fit_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_noise_scale_formula": {
      "type": "string"
    },
    "pre_level_formula": {
      "type": "string"
    },
    "post_level_formula": {
      "type": "string"
    },
    "step_amplitude_formula": {
      "type": "string"
    },
    "minimum_nontrivial_amplitudes": {
      "type": "integer"
    },
    "q75_method": {
      "type": "string"
    },
    "source_step_threshold_formula": {
      "type": "string"
    },
    "source_stability_tolerance_formula": {
      "type": "string"
    },
    "cluster_retention_policy": {
      "type": "string"
    },
    "exact_amplitude_tie_policy": {
      "type": "string"
    },
    "directions_retained_separately": {
      "type": "boolean"
    },
    "calibration_or_target_feedback_used": {
      "type": "boolean"
    },
    "final_rule_parameter_authority": {
      "type": "boolean"
    },
    "creation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "code_commit",
        "config_hash"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "continuous_step_trigger_policy_v1"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

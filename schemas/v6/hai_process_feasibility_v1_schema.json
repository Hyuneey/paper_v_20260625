{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/hai_process_feasibility_v1_schema.json",
  "title": "HAI Process Feasibility V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "process_id", "process_name", "process_feature_count", "metadata_reviewed_count", "metadata_unresolved_count", "eligible_source_variable_count", "eligible_source_transition_count", "eligible_continuous_target_count", "screened_pair_count", "fit_supported_pair_count", "calibration_confirmed_pair_count", "canonical_increase_ready_pair_count", "future_decrease_pair_count", "distinct_confirmed_source_count", "distinct_confirmed_target_count", "fit_to_calibration_transfer_rate", "median_fit_isolated_trigger_count", "median_calibration_isolated_trigger_count", "median_isolation_ratio", "missing_or_nonfinite_rate", "official_graph_reference_available", "manual_metadata_coverage", "boundary_violation_count", "candidate_fit_files", "calibration_file", "normal_guard_values_accessed", "feasibility_gate_passed", "private_screening_ledger_hash", "claim_boundary", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "hai_process_feasibility_v1"},
    "process_id": {"enum": ["P1", "P3"]},
    "process_name": {"enum": ["Boiler", "Water Treatment"]},
    "process_feature_count": {"$ref": "#/$defs/count"},
    "metadata_reviewed_count": {"$ref": "#/$defs/count"},
    "metadata_unresolved_count": {"$ref": "#/$defs/count"},
    "eligible_source_variable_count": {"$ref": "#/$defs/count"},
    "eligible_source_transition_count": {"$ref": "#/$defs/count"},
    "eligible_continuous_target_count": {"$ref": "#/$defs/count"},
    "screened_pair_count": {"$ref": "#/$defs/count"},
    "fit_supported_pair_count": {"$ref": "#/$defs/count"},
    "calibration_confirmed_pair_count": {"$ref": "#/$defs/count"},
    "canonical_increase_ready_pair_count": {"$ref": "#/$defs/count"},
    "future_decrease_pair_count": {"$ref": "#/$defs/count"},
    "distinct_confirmed_source_count": {"$ref": "#/$defs/count"},
    "distinct_confirmed_target_count": {"$ref": "#/$defs/count"},
    "fit_to_calibration_transfer_rate": {"$ref": "#/$defs/ratio"},
    "median_fit_isolated_trigger_count": {"type": "number", "minimum": 0},
    "median_calibration_isolated_trigger_count": {"type": "number", "minimum": 0},
    "median_isolation_ratio": {"$ref": "#/$defs/ratio"},
    "missing_or_nonfinite_rate": {"$ref": "#/$defs/ratio"},
    "official_graph_reference_available": {"type": "boolean"},
    "manual_metadata_coverage": {"$ref": "#/$defs/ratio"},
    "boundary_violation_count": {"$ref": "#/$defs/count"},
    "candidate_fit_files": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "calibration_file": {"type": "string"},
    "normal_guard_values_accessed": {"const": false},
    "feasibility_gate_passed": {"type": "boolean"},
    "private_screening_ledger_hash": {"$ref": "#/$defs/hash"},
    "claim_boundary": {"const": "normal_only_feasibility_not_causal_or_performance_evidence"},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

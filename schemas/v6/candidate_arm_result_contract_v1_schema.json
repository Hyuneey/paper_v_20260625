{
  "$id": "https://paperworks.local/schemas/v6/candidate_arm_result_contract_v1_schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "artifact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "artifact_type": {
      "const": "candidate_arm_result_contract_v1",
      "type": "string"
    },
    "budget_views": {
      "items": {
        "type": "integer"
      },
      "type": "array"
    },
    "candidate_shortfall_required": {
      "type": "boolean"
    },
    "common_universe_required": {
      "type": "boolean"
    },
    "creation_metadata": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        }
      },
      "required": [
        "code_commit",
        "config_hash",
        "created_at",
        "created_by"
      ],
      "type": "object"
    },
    "cross_arm_score_prohibited": {
      "type": "boolean"
    },
    "gdn_statuses": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "meta_stat_statuses": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "method_specific_score_only": {
      "type": "boolean"
    },
    "one_deterministic_ranking_required": {
      "type": "boolean"
    },
    "raw_hai_values_allowed": {
      "type": "boolean"
    },
    "required_provenance_fields": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "result_created": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "supported_candidate_only": {
      "type": "boolean"
    }
  },
  "required": [
    "arm_ids",
    "artifact_hash",
    "artifact_type",
    "budget_views",
    "candidate_shortfall_required",
    "common_universe_required",
    "creation_metadata",
    "cross_arm_score_prohibited",
    "gdn_statuses",
    "meta_stat_statuses",
    "method_specific_score_only",
    "one_deterministic_ranking_required",
    "raw_hai_values_allowed",
    "required_provenance_fields",
    "result_created",
    "schema_version",
    "supported_candidate_only"
  ],
  "title": "candidate_arm_result_contract_v1",
  "type": "object"
}

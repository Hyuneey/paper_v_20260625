{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_step_process_selection_policy_v1_schema.json",
  "title": "Continuous Step Process Selection Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compared_processes",
    "source_threshold_count_minimum",
    "eligible_target_count_minimum",
    "confirmed_directional_pair_count_minimum",
    "distinct_confirmed_source_count_minimum",
    "distinct_confirmed_target_count_minimum",
    "transfer_rate_minimum",
    "required_fit_files",
    "required_calibration_file",
    "normal_guard_values_prohibited",
    "prohibited_access_count_maximum",
    "maximize_metrics",
    "minimize_metrics",
    "strict_improvement_metric_minimum",
    "weighted_score_used",
    "prohibited_selection_bases",
    "neither_feasible_status",
    "non_dominance_status",
    "creation_metadata",
    "schema_version",
    "artifact_type",
    "artifact_hash"
  ],
  "properties": {
    "compared_processes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_threshold_count_minimum": {
      "type": "integer"
    },
    "eligible_target_count_minimum": {
      "type": "integer"
    },
    "confirmed_directional_pair_count_minimum": {
      "type": "integer"
    },
    "distinct_confirmed_source_count_minimum": {
      "type": "integer"
    },
    "distinct_confirmed_target_count_minimum": {
      "type": "integer"
    },
    "transfer_rate_minimum": {
      "type": "number"
    },
    "required_fit_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_calibration_file": {
      "type": "string"
    },
    "normal_guard_values_prohibited": {
      "type": "boolean"
    },
    "prohibited_access_count_maximum": {
      "type": "integer"
    },
    "maximize_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minimize_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strict_improvement_metric_minimum": {
      "type": "integer"
    },
    "weighted_score_used": {
      "type": "boolean"
    },
    "prohibited_selection_bases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "neither_feasible_status": {
      "type": "string"
    },
    "non_dominance_status": {
      "type": "string"
    },
    "creation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "code_commit",
        "config_hash"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "continuous_step_process_selection_policy_v1"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

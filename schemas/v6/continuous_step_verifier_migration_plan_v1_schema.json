{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_step_verifier_migration_plan_v1_schema.json",
  "title": "Continuous Step Verifier Migration Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_status",
    "ordered_future_checks",
    "validity_excludes",
    "verifier_v1_modified",
    "implementation_created",
    "creation_metadata",
    "schema_version",
    "artifact_type",
    "artifact_hash"
  ],
  "properties": {
    "plan_status": {
      "type": "string"
    },
    "ordered_future_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validity_excludes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifier_v1_modified": {
      "type": "boolean"
    },
    "implementation_created": {
      "type": "boolean"
    },
    "creation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "code_commit",
        "config_hash"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "continuous_step_verifier_migration_plan_v1"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

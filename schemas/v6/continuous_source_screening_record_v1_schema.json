{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_source_screening_record_v1_schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "process_id", "variable_name", "metadata_record_hash", "morphology_record_hash", "fit_files", "source_noise_scale", "nontrivial_amplitude_count", "source_step_threshold", "source_stability_tolerance", "q75_method", "status", "parameter_class", "fit_only", "calibration_or_target_feedback_used", "final_parameter_authority", "creation_metadata", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "continuous_source_screening_record_v1"},
    "process_id": {"enum": ["P1", "P3"]},
    "variable_name": {"type": "string", "minLength": 1},
    "metadata_record_hash": {"$ref": "#/$defs/hash"},
    "morphology_record_hash": {"$ref": "#/$defs/hash"},
    "fit_files": {"type": "array", "prefixItems": [{"const": "hai-23.05/hai-train1.csv"}, {"const": "hai-23.05/hai-train2.csv"}], "items": false, "minItems": 2, "maxItems": 2},
    "source_noise_scale": {"type": ["number", "null"]},
    "nontrivial_amplitude_count": {"type": "integer", "minimum": 0},
    "source_step_threshold": {"type": ["number", "null"]},
    "source_stability_tolerance": {"type": ["number", "null"]},
    "q75_method": {"const": "linear_interpolation_index_0.75_times_n_minus_1"},
    "status": {"enum": ["supported", "insufficient_nontrivial_amplitudes", "invalid_source"]},
    "parameter_class": {"const": "feasibility_screening"},
    "fit_only": {"const": true},
    "calibration_or_target_feedback_used": {"const": false},
    "final_parameter_authority": {"const": false},
    "creation_metadata": {"$ref": "#/$defs/creation"},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "creation": {"type": "object", "additionalProperties": false, "required": ["created_at", "created_by", "code_commit", "config_hash"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string"}, "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "config_hash": {"$ref": "#/$defs/hash"}}}
  }
}

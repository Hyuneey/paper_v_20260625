{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_calibration_confirmation_record_v1_schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "process_id", "fit_record_ref", "source_variable", "source_step_direction", "target_variable", "target_response_direction", "selected_horizon_seconds", "train3_usable_isolated_events", "train3_right_censored", "train3_directional_consistency", "train3_opposite_direction_consistency", "train3_robust_effect_ratio", "target_direction_unchanged", "fit_parameters_reused_without_retuning", "source_threshold_ref", "target_scale_ref", "status", "creation_metadata", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "continuous_calibration_confirmation_record_v1"}, "process_id": {"enum": ["P1", "P3"]}, "fit_record_ref": {"$ref": "#/$defs/hash"}, "source_variable": {"type": "string"}, "source_step_direction": {"enum": ["step_up", "step_down"]}, "target_variable": {"type": "string"}, "target_response_direction": {"enum": ["increase", "decrease"]}, "selected_horizon_seconds": {"enum": [1, 5, 10, 30, 60]},
    "train3_usable_isolated_events": {"type": "integer", "minimum": 0}, "train3_right_censored": {"type": "integer", "minimum": 0}, "train3_directional_consistency": {"type": "number", "minimum": 0, "maximum": 1}, "train3_opposite_direction_consistency": {"type": "number", "minimum": 0, "maximum": 1}, "train3_robust_effect_ratio": {"type": "number", "minimum": 0}, "target_direction_unchanged": {"type": "boolean"}, "fit_parameters_reused_without_retuning": {"const": true}, "source_threshold_ref": {"$ref": "#/$defs/hash"}, "target_scale_ref": {"$ref": "#/$defs/hash"}, "status": {"enum": ["calibration_confirmed", "calibration_conflict"]}, "creation_metadata": {"$ref": "#/$defs/creation"}, "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "creation": {"type": "object", "additionalProperties": false, "required": ["created_at", "created_by", "code_commit", "config_hash"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string"}, "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "config_hash": {"$ref": "#/$defs/hash"}}}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_target_scale_record_v1_schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "process_id", "target_variable", "metadata_record_hash", "fit_files", "target_noise_scale", "status", "parameter_class", "fit_only", "calibration_values_used", "final_parameter_authority", "creation_metadata", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "continuous_target_scale_record_v1"}, "process_id": {"enum": ["P1", "P3"]}, "target_variable": {"type": "string"},
    "metadata_record_hash": {"$ref": "#/$defs/hash"}, "fit_files": {"type": "array", "prefixItems": [{"const": "hai-23.05/hai-train1.csv"}, {"const": "hai-23.05/hai-train2.csv"}], "items": false},
    "target_noise_scale": {"type": ["number", "null"]}, "status": {"enum": ["supported", "invalid_target"]}, "parameter_class": {"const": "feasibility_screening"}, "fit_only": {"const": true},
    "calibration_values_used": {"const": false}, "final_parameter_authority": {"const": false}, "creation_metadata": {"$ref": "#/$defs/creation"}, "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "creation": {"type": "object", "additionalProperties": false, "required": ["created_at", "created_by", "code_commit", "config_hash"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string"}, "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "config_hash": {"$ref": "#/$defs/hash"}}}}
}

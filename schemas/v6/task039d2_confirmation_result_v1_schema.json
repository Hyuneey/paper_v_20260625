{
  "$id": "https://paperworks.local/schemas/v6/task039d2_confirmation_result_v1_schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task039d2_confirmation_result_v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "probability": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  },
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "execution_mode",
    "confirmation_policy_hash",
    "relation_binding_hash",
    "d1_directional_record_hash",
    "source",
    "source_step_direction",
    "target",
    "target_response_direction",
    "selected_horizon_seconds",
    "parameter_ledger_bindings_hash",
    "usable_response_count",
    "right_censored_count",
    "selected_directional_consistency",
    "opposite_directional_consistency",
    "median_target_response",
    "robust_effect_ratio",
    "source_direction_unchanged",
    "target_direction_unchanged",
    "fit_parameters_reused_without_retuning",
    "alternative_horizon_search_performed",
    "opposite_direction_search_performed",
    "lower_ranked_fallback_used",
    "candidate_arm_provenance_visible",
    "method_provenance_joined",
    "status",
    "d2_real_execution_authorized",
    "rule_v2_authorized",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "task039d2_confirmation_result_v1"},
    "task_id": {"const": "TASK-039D2-PREP"},
    "execution_mode": {"const": "synthetic_only_preparation"},
    "confirmation_policy_hash": {
      "const": "83419f6acefaeb21ebc329d5ff9df8563e9636da72ad5367318a172df8fb0b27"
    },
    "relation_binding_hash": {"$ref": "#/$defs/sha256"},
    "d1_directional_record_hash": {"$ref": "#/$defs/sha256"},
    "source": {"type": "string", "minLength": 1},
    "source_step_direction": {"enum": ["step_up", "step_down"]},
    "target": {"type": "string", "minLength": 1},
    "target_response_direction": {"enum": ["increase", "decrease"]},
    "selected_horizon_seconds": {"enum": [1, 5, 10, 30, 60]},
    "parameter_ledger_bindings_hash": {"$ref": "#/$defs/sha256"},
    "usable_response_count": {"type": "integer", "minimum": 0},
    "right_censored_count": {"type": "integer", "minimum": 0},
    "selected_directional_consistency": {"$ref": "#/$defs/probability"},
    "opposite_directional_consistency": {"$ref": "#/$defs/probability"},
    "median_target_response": {"type": ["number", "null"]},
    "robust_effect_ratio": {"type": "number", "minimum": 0.0},
    "source_direction_unchanged": {"const": true},
    "target_direction_unchanged": {"type": "boolean"},
    "fit_parameters_reused_without_retuning": {"const": true},
    "alternative_horizon_search_performed": {"const": false},
    "opposite_direction_search_performed": {"const": false},
    "lower_ranked_fallback_used": {"const": false},
    "candidate_arm_provenance_visible": {"const": false},
    "method_provenance_joined": {"const": false},
    "status": {"enum": ["calibration_confirmed", "calibration_conflict"]},
    "d2_real_execution_authorized": {"const": false},
    "rule_v2_authorized": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  }
}

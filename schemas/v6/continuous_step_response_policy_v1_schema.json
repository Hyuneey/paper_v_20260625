{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/continuous_step_response_policy_v1_schema.json",
  "title": "Continuous Step Response Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_observed_domain",
    "target_pre_window_seconds",
    "target_response_window_seconds",
    "response_horizons_seconds",
    "target_baseline_formula",
    "target_response_formula",
    "target_noise_scale_formula",
    "target_noise_fit_role",
    "increase_evidence_rule",
    "decrease_evidence_rule",
    "right_censor_incomplete_windows",
    "preserve_response_direction",
    "absolute_response_only_prohibited",
    "creation_metadata",
    "schema_version",
    "artifact_type",
    "artifact_hash"
  ],
  "properties": {
    "target_observed_domain": {
      "type": "string"
    },
    "target_pre_window_seconds": {
      "type": "integer"
    },
    "target_response_window_seconds": {
      "type": "integer"
    },
    "response_horizons_seconds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "target_baseline_formula": {
      "type": "string"
    },
    "target_response_formula": {
      "type": "string"
    },
    "target_noise_scale_formula": {
      "type": "string"
    },
    "target_noise_fit_role": {
      "type": "string"
    },
    "increase_evidence_rule": {
      "type": "string"
    },
    "decrease_evidence_rule": {
      "type": "string"
    },
    "right_censor_incomplete_windows": {
      "type": "boolean"
    },
    "preserve_response_direction": {
      "type": "boolean"
    },
    "absolute_response_only_prohibited": {
      "type": "boolean"
    },
    "creation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "code_commit",
        "config_hash"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "continuous_step_response_policy_v1"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

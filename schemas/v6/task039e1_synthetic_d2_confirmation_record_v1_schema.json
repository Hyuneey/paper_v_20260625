{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/task039e1_synthetic_d2_confirmation_record_v1_schema.json",
  "title": "Synthetic D2 confirmation record preparation draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "source", "target",
    "source_step_direction", "target_response_direction",
    "selected_horizon_seconds", "source_parameter_record_hash",
    "target_parameter_record_hash", "d1_directional_record_hash",
    "confirmation_status", "fit_parameters_reused_without_retuning",
    "synthetic_fixture", "real_record", "runtime_authority_granted",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "task039e1_synthetic_d2_confirmation_record_v1"},
    "source": {"$ref": "#/$defs/syntheticIdentifier"},
    "target": {"$ref": "#/$defs/syntheticIdentifier"},
    "source_step_direction": {"enum": ["step_up", "step_down"]},
    "target_response_direction": {"enum": ["increase", "decrease"]},
    "selected_horizon_seconds": {"type": "integer", "minimum": 1},
    "source_parameter_record_hash": {"$ref": "#/$defs/hash"},
    "target_parameter_record_hash": {"$ref": "#/$defs/hash"},
    "d1_directional_record_hash": {"$ref": "#/$defs/hash"},
    "confirmation_status": {"enum": ["calibration_confirmed", "calibration_conflict"]},
    "fit_parameters_reused_without_retuning": {"type": "boolean"},
    "synthetic_fixture": {"const": true},
    "real_record": {"const": false},
    "runtime_authority_granted": {"const": false},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "syntheticIdentifier": {"type": "string", "pattern": "^SYNTHETIC_[A-Za-z0-9._:-]+$"}
  }
}

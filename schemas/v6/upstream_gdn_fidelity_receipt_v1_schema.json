{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworks.local/schemas/v6/upstream_gdn_fidelity_receipt_v1_schema.json",
  "title": "UpstreamGDNFidelityReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "status",
    "protocol_bundle_hash",
    "gdn_policy_hash",
    "pair_universe_hash",
    "source_verification",
    "backend_id",
    "backend_classification",
    "implementation_module",
    "implementation_sha256",
    "training_config",
    "field_assessments",
    "unresolved_fields",
    "smoke_backend_used",
    "dependency_status",
    "real_hai_feature_values_accessed",
    "created_at",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "upstream_gdn_fidelity_receipt_v1"},
    "task_id": {"const": "TASK-039C-GDN"},
    "status": {"enum": ["passed_upstream_gdn_fidelity", "blocked_upstream_gdn_backend_unresolved"]},
    "protocol_bundle_hash": {"const": "41aab751d6bbbaadc72a95ef3289ea6440c26659fb38f640bf17fb0688836dff"},
    "gdn_policy_hash": {"const": "9c2387a98312ef6c96ddcd17a871ceb70a96b670eb4a39a7269878101f2ba41a"},
    "pair_universe_hash": {"const": "fc072d3e18ce4623972c2cb64f6266727092ecae03fdb0f0dd929d705e1d8557"},
    "source_verification": {"$ref": "#/$defs/sourceVerification"},
    "backend_id": {"const": "task039c_upstream_aligned_gdn_v1"},
    "backend_classification": {"enum": ["upstream_aligned_validated", "upstream_aligned_unverified"]},
    "implementation_module": {"const": "paperworks.gdn.upstream_candidate_backend_v1"},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "training_config": {"$ref": "#/$defs/trainingConfig"},
    "field_assessments": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/fieldAssessment"}
    },
    "unresolved_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "smoke_backend_used": {"const": false},
    "dependency_status": {"$ref": "#/$defs/dependencyStatus"},
    "real_hai_feature_values_accessed": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "git_blob_sha": {"$ref": "#/$defs/gitSha"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "detached_head", "clean_worktree", "file_records", "verification_method"],
      "properties": {
        "repository": {"const": "https://github.com/d-ailin/GDN"},
        "commit": {"const": "9853899da860682669a134e4af315d036aab4eca"},
        "detached_head": {"const": true},
        "clean_worktree": {"const": true},
        "file_records": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/fileRecord"}},
        "verification_method": {"const": "git_commit_blob_identity_and_canonical_blob_sha256"}
      }
    },
    "trainingConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "batch_size", "epochs", "slide_window", "slide_stride", "embedding_dim", "out_layer_num", "out_layer_inter_dim", "learned_graph_topk", "validation_ratio", "learning_rate", "weight_decay", "early_stopping_patience", "dropout", "device", "preprocessing", "validation_policy", "checkpoint_policy", "hyperparameter_hash"],
      "properties": {
        "seeds": {"const": [11, 23, 37]},
        "batch_size": {"const": 32},
        "epochs": {"const": 30},
        "slide_window": {"const": 5},
        "slide_stride": {"const": 1},
        "embedding_dim": {"const": 64},
        "out_layer_num": {"const": 1},
        "out_layer_inter_dim": {"const": 128},
        "learned_graph_topk": {"const": 5},
        "validation_ratio": {"const": 0.2},
        "learning_rate": {"const": 0.001},
        "weight_decay": {"const": 0.0},
        "early_stopping_patience": {"const": 15},
        "dropout": {"const": 0.2},
        "device": {"const": "cpu"},
        "preprocessing": {"const": "raw_numeric_values_no_scaling_windows_do_not_cross_files"},
        "validation_policy": {"const": "upstream_seeded_contiguous_random_validation_block"},
        "checkpoint_policy": {"const": "minimum_validation_loss_in_memory_state_dict"},
        "hyperparameter_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "fieldAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_name", "classification", "upstream_sources", "implementation_evidence", "rationale"],
      "properties": {
        "field_name": {"type": "string"},
        "classification": {"enum": ["exact_upstream", "dimension_adaptation", "documented_non_scientific_adapter", "unresolved"]},
        "upstream_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "implementation_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "python_version", "platform_id", "torch_version", "torch_geometric_version", "exact_approved_backend"],
      "properties": {
        "environment_id": {"type": "string"},
        "python_version": {"type": "string"},
        "platform_id": {"type": "string"},
        "torch_version": {"type": ["string", "null"]},
        "torch_geometric_version": {"type": ["string", "null"]},
        "exact_approved_backend": {"type": "boolean"}
      }
    },
    "dependencyStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_versions", "upstream_native_reference_versions", "inspection_policy", "environments", "exact_backend_available", "selected_environment_id", "dependency_status", "environment_fingerprint"],
      "properties": {
        "required_versions": {"const": {"torch": "2.12.1", "torch-geometric": "2.8.0"}},
        "upstream_native_reference_versions": {"const": {"torch": "1.5.1", "torch-geometric": "1.5.0"}},
        "inspection_policy": {"const": "already_approved_environments_only_no_install_or_upgrade"},
        "environments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/environment"}},
        "exact_backend_available": {"type": "boolean"},
        "selected_environment_id": {"type": ["string", "null"]},
        "dependency_status": {"enum": ["available", "blocked_optional_dependency"]},
        "environment_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
